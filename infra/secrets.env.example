# Copy to infra/secrets.env and fill in. secrets.env is git-ignored.
# Every ${NAME} in infra/profiles is resolved from this file (or from a server's `vars`).

# --- Pterodactyl client API (Account → API Credentials, key starts with ptlc_) ---
# The panel runs on its own server. Plugin uploads go straight to the node's Wings
# (signed URL from the panel), so this machine must also reach the node's Wings address.
PTERO_URL=https://panel.rapidskies.us
PTERO_API_KEY=ptlc_changeme
# Only needed if panel.rapidskies.us sits behind Cloudflare Access: create a service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Velocity modern forwarding ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VELOCITY_SECRET=changeme

# --- MariaDB and Redis, as the game containers on the node reach them ---
# On the node itself: 172.18.0.1 (Pterodactyl's Docker gateway).
# On the panel server: its private IP (172.18.0.1 would point back at the node).
# Firewall either one so only the node can connect. See infra/README.md → Where things run.
DB_HOST=172.18.0.1
DB_PORT=3306
LP_DB_NAME=luckperms
LP_DB_USER=luckperms
LP_DB_PASSWORD=changeme

# rapid-* plugins (rapid-proxy, rapid-core, ...): one shared schema, separate from LuckPerms.
# Create it once:  CREATE DATABASE rapidskies CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#                  GRANT ALL ON rapidskies.* TO 'rapidskies'@'<container subnet>' IDENTIFIED BY '...';
RAPID_DB_NAME=rapidskies
RAPID_DB_USER=rapidskies
RAPID_DB_PASSWORD=changeme

# Staging's own rapid-* database, so tests never touch production data (network.yml maps
# these onto staging's RAPID_DB_*). Create it in the panel (staging server → Databases) and
# copy the name and user it shows (Pterodactyl prefixes them, e.g. s12_rapidskies / u12_AbCd).
STAGING_RAPID_DB_NAME=s0_rapidskies
STAGING_RAPID_DB_USER=u0_changeme
STAGING_RAPID_DB_PASSWORD=changeme

# LiteBans (Velocity only): its own schema, like LuckPerms.
LITEBANS_DB_NAME=litebans
LITEBANS_DB_USER=litebans
LITEBANS_DB_PASSWORD=changeme

# SuperiorSkyblock2 (skyrealms only): its own schema, like LiteBans. Its port comes from
# profiles/skyrealms/plugins/SuperiorSkyblock2/config.yml.patch (keep it equal to DB_PORT).
SS2_DB_NAME=superiorskyblock
SS2_DB_USER=superiorskyblock
SS2_DB_PASSWORD=changeme

# Grim (every Paper backend except staging): the anticheat's violation history, shared so
# /grim history works across servers. Its own schema; its port comes from
# profiles/paper-base/plugins/GrimAC/databases/mysql.yml.patch (keep it equal to DB_PORT).
GRIM_DB_NAME=grim
GRIM_DB_USER=grim
GRIM_DB_PASSWORD=changeme

REDIS_HOST=172.18.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme
