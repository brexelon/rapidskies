# /etc/rapidskies/backup-db.env (chmod 600). One per machine; see infra/README.md → Backups.

# Offsite target. Give each machine its own path so retention never crosses machines:
#   game node:    b2:rapidskies-backups/node
#   panel server: b2:rapidskies-backups/panel
RCLONE_REMOTE=b2:rapidskies-backups/node
KEEP_REMOTE_DAYS=30

# Database dumps. Set DUMP_DATABASES=false on a machine with no MariaDB (e.g. the node,
# when MariaDB lives on the panel server). A read-only user is enough:
#   CREATE USER 'backup'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT, PROCESS ON *.* TO 'backup'@'localhost';
DUMP_DATABASES=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backup
DB_PASSWORD=changeme
LOCAL_DIR=/var/backups/rapidskies
KEEP_LOCAL_DAYS=7

# Game node only: Wings' local backup folder. Leave empty on the panel server, or if Wings
# stores backups in S3/B2 itself.
WINGS_BACKUP_DIR=/var/lib/pterodactyl/backups
