# /etc/rapidskies/backup-db.env (chmod 600). A read-only MariaDB user is enough:
#   CREATE USER 'backup'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT, PROCESS ON *.* TO 'backup'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backup
DB_PASSWORD=changeme
LOCAL_DIR=/var/backups/rapidskies
KEEP_LOCAL_DAYS=7
RCLONE_REMOTE=b2:rapidskies-backups
WINGS_BACKUP_DIR=/var/lib/pterodactyl/backups
KEEP_REMOTE_DAYS=30
