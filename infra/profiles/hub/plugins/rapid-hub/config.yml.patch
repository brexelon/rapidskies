# rapid-hub on the Free Lobby (worlds/Free Lobby). Positions come from the build itself;
# fine-tune in-game with /rapidhub here (prints copyable lines) and /rapidhub reload, then
# put the final values here, or the next `rsdeploy.py apply` puts these back.

# Mode NPCs on the stage in front of the gate hall: the semicircle under the birch arch,
# floor y 86, with five stone-slab pedestals in an arc. SkyRealms and Horizons take the
# inner pair (on the players' left and right, seen from the spawn), standing on the slabs
# (y 86.5) and facing south to the spawn terrace; they turn to look at players nearby.
# The centre pedestal (-6 86 -12) is left free for gamemode 3 (PLAN.md §5.4).
modes.skyrealms.npc: "minecraft:overworld, -7.5, 86.5, -10.5, 0, 0"
modes.smp.npc: "minecraft:overworld, -3.5, 86.5, -10.5, 0, 0"

# The hub parkour: a random course per run, generated in its own void world
# (rapidskies:parkour, created by rapid-core: profiles/hub/plugins/rapid-core). 150 blocks
# with checkpoints at 50 and 100. To add an entrance plate in the courtyard, stand on it and
# put /rapidhub here's block position in parkour.courses.main.entrance.
parkour.world: "rapidskies:parkour"
parkour.courses.main.length: 150
parkour.courses.main.checkpoint-every: 50

# Leaderboards over the round floor emblems on either side of the courtyard, both in view
# from the spawn: all time on the left (west), this week on the right (east).
leaderboards.parkour-all.location: "minecraft:overworld, -16, 86, -1"
leaderboards.parkour-all.course: "main"
leaderboards.parkour-all.size: 10
leaderboards.parkour-weekly.location: "minecraft:overworld, 5, 86, -1"
leaderboards.parkour-weekly.course: "main"
leaderboards.parkour-weekly.weekly: true
leaderboards.parkour-weekly.size: 10
