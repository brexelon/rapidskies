# Hub spawn and world (rapid-core WorldService). minecraft:overworld is the `hub` level, the
# Rapid Lobby (worlds/revamped/rapid-lobby-spawn). The spawn is the yellow concrete at the
# centre of the medallion on the raised south terrace (block 0 79 0), facing north over the
# plaza to the lightning spire, with the SkyRealms bridgehead ahead left and Horizons ahead
# right. Tweak in-game with /setspawn, which prints the replacement line.
spawn.location: "minecraft:overworld, 0.5, 80, 0.5, 180, 0"
spawn.on-join: "always"
spawn.on-death: true
worlds:
  "minecraft:overworld":
    protect: true
    # The doors, gates, buttons and ender chests in the build are scenery: none of them open.
    usable-blocks: false
    # The lowest blocks (the dripstone tip under the island) are at y 37.
    void-y: 20
    time: 6000
    clear-weather: true
    game-rules:
      advance_time: false
      advance_weather: false
      spawn_mobs: false
      spawn_monsters: false
      spawn_phantoms: false
      spawn_patrols: false
      spawn_wandering_traders: false
      pvp: false
      fall_damage: false
      mob_griefing: false
      # Keeps leaves, grass and the build exactly as delivered (the builders shipped it with 0).
      random_tick_speed: 0
      fire_spread_radius_around_player: 0
      fire_damage: false
      drowning_damage: false
      freeze_damage: false
      keep_inventory: true
      immediate_respawn: true
      show_advancement_messages: false
      show_death_messages: false
      locator_bar: false
      allow_entering_nether_using_portals: false
  # rapid-hub's parkour: an empty void world where each run's random course is built in a
  # lane of its own and removed afterwards (rapid-hub parkour.world). No void-y: rapid-hub
  # puts fallers back on their checkpoint, and sends anyone else back to the hub spawn.
  "rapidskies:parkour":
    create: void
    protect: true
    time: 6000
    clear-weather: true
    game-rules:
      advance_time: false
      advance_weather: false
      spawn_mobs: false
      spawn_monsters: false
      spawn_phantoms: false
      spawn_patrols: false
      spawn_wandering_traders: false
      pvp: false
      fall_damage: false
      mob_griefing: false
      random_tick_speed: 0
      fire_damage: false
      drowning_damage: false
      freeze_damage: false
      keep_inventory: true
      immediate_respawn: true
      show_advancement_messages: false
      show_death_messages: false
      locator_bar: false
