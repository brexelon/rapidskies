# rapid-essentials on the hubs: just /spawn and the everyday info commands. Players move between
# modes with the game menu and /play, so the hub has no homes, warps, /tpa or /back.
disabled-commands:
  - back
  - tpa
  - tpahere
  - tpaccept
  - tpdeny
  - tpacancel
  - tptoggle
  - home
  - sethome
  - delhome
  - homes
  - warp
  - warps
  - setwarp
  - delwarp
  # Hub flight is rapid-hub's /fly (rapid.hub.fly, with double jump); ours would fight it.
  - fly
