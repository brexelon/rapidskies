# rapid-essentials on Horizons. A short warmup on teleports: standing still (and not getting
# hit) for 3 seconds means /home and /spawn aren't instant escapes from mobs or lava either.
# Combat-tagged players can't use them at all (rapid-horizons' guard, pvp.combat-tag-seconds).
teleport.warmup-seconds: 3
# Frontier worlds (rapidskies:frontier_<n>, its _nether and _end) are deleted every month, so a
# home there would point nowhere.
homes.blocked-worlds: ["rapidskies:frontier_*"]
