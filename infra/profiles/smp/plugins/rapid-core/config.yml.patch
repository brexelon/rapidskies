# Horizons: rapid-core serves Crowns through Vault (QuickShop) and spends Tailwind here.
server.gamemode: "horizons"

# Spawn: the Horizons spawn island (worlds/revamped/horizons-smp-spawn), its own world beside
# the Heartland (rapidskies:spawn, stored in heartland/dimensions/rapidskies/spawn). Players
# appear on the lodestone atop the pedestal in the middle of the village plaza (block 0 79 0),
# facing north to the portal gate between its two towers. New players start here and deaths
# without a bed come back here; the way out to the Heartland is rapid-horizons' job: the
# portal gate, its NPCs and /rtp (profiles/smp/plugins/rapid-horizons).
spawn.location: "rapidskies:spawn, 0.5, 80, 0.5, 180, 0"
spawn.on-join: "first-join"
spawn.on-death: true
worlds:
  # The Heartland: a 10,000 x 10,000 square (+-5,000 around 0, 0), pre-generated with Chunky
  # (infra/README.md -> The Heartland). /rtp lands inside it (rapid-horizons rtp.max-radius 5000).
  "minecraft:overworld":
    border:
      center-x: 0
      center-z: 0
      size: 10000
  "rapidskies:spawn":
    # A sky island: void all around.
    create: void
    protect: true
    # The lowest blocks (the island's underside) are at y 15.
    void-y: 0
    # Morning, as the builders froze it.
    time: 2000
    clear-weather: true
    game-rules:
      advance_time: false
      advance_weather: false
      spawn_mobs: false
      spawn_monsters: false
      spawn_phantoms: false
      spawn_patrols: false
      spawn_wandering_traders: false
      pvp: false
      fall_damage: false
      mob_griefing: false
      # Keeps leaves, crops, farmland and the build exactly as delivered (the builders shipped it with 0).
      random_tick_speed: 0
      fire_spread_radius_around_player: 0
      # The arch's portal blocks lead to the Heartland (rapid-horizons), never the Nether.
      allow_entering_nether_using_portals: false

# The sidebar's World line (%rapid_world%) instead of the folder names.
world-names:
  "rapidskies:spawn": "Spawn"
  "minecraft:overworld": "Heartland"
  "minecraft:the_nether": "The Nether"
  "minecraft:the_end": "The End"
