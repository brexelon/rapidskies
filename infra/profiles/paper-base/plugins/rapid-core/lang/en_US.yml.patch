# rapid-core's lang/en_US.yml is a full copy of the bundled messages, written on first start,
# and every key in it overrides the jar's. Keys whose wording changed after that are pinned
# here so the live copies follow. Delete a line once every server's copy has been regenerated
# (remove plugins/rapid-core/lang/en_US.yml and restart).
tailwind.banked: "<prefix><primary>Tailwind:</primary> <text><time> banked.</text> <muted>It's spent while you play SkyRealms or Horizons, for</muted> <accent>+<bonus>%</accent> <muted>mode XP and Trade income.</muted>"
