# spigot.yml. Must stay false with Velocity modern forwarding.
settings.bungeecord: false
# Pterodactyl restarts crashed servers; Spigot's restart script would fight it.
settings.restart-on-crash: false
commands.log: true
# Spigot only reads & codes. Every client that gets this far is 1.20+, so the brand color
# is exact: &x&F&F&D&8&0&0 is #FFD800 (Spigot doesn't read the &#RRGGBB form). &6, &8 and &7
# already equal accent #FFAA00, dark #555555 and muted #AAAAAA.
messages.unknown-command: "&x&F&F&D&8&0&0&lRAPID&f&lSKIES &8» &7Unknown command. Try &6/help&7."
messages.whitelist: "&x&F&F&D&8&0&0&lRAPID&f&lSKIES\n&7This server is for staff only."
messages.server-full: "&x&F&F&D&8&0&0&lRAPID&f&lSKIES\n&7This server is full. Please try again in a moment."
