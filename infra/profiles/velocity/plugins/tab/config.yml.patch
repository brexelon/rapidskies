# TAB (Velocity): header/footer and tab-list sorting for every client version (plan §2, §4).
# Each mapping below replaces TAB's whole example section.
#
# Rank prefixes in the tab list and nametags are set in groups.yml.patch: rapid-core's
# %rapid_prefix%, read from the backends through TAB-Bridge. Scoreboard teams need
# VelocityScoreboardAPI next to TAB (proxy plugin set).
header-footer:
  enabled: true
  designs:
    default:
      header:
        - ""
        - "<#FFD800><bold>RAPID</bold></#FFD800><white><bold>SKIES</bold></white>"
        - "<#AAAAAA>%online% online</#AAAAAA>"
        - ""
      footer:
        - ""
        - "<#AAAAAA>Store:</#AAAAAA> <#FFD800>store.rapidskies.us</#FFD800>"
        - "<#FFD800>rapidskies.us</#FFD800>"
        - ""
tablist-name-formatting:
  enabled: true
scoreboard-teams:
  enabled: true
  enable-collision: true
  invisible-nametags: false
  # Team first (rapid-core's StaffRole order), then paid ranks (luckperms/bootstrap.txt).
  sorting-types:
    - "GROUPS:owner,admin,developer,srmod,moderator,helper,builder,rapidplusplusplus,rapidplusplus,rapidplus,default"
    - "PLACEHOLDER_A_TO_Z:%player%"
  case-sensitive-sorting: false
  can-see-friendly-invisibles: false
playerlist-objective:
  enabled: false
belowname-objective:
  enabled: false
bossbar:
  enabled: false
# Sidebars (plan §2, §3): one per kind of server, picked by the backend's name in
# velocity.toml (hub-1, skyrealms-1, smp-1, ...); the first whose display-condition matches
# is shown, so the plain one for build/staging goes last. `<-` is "contains" (TAB's `|`
# means OR, so the starts-with operator would be ambiguous here).
# Lines use TAB's own color codes (&#RRGGBB, &7, &l) so the legacy-colored values from
# rapid-core (%rapid_rank_name% carries the plus color) mix in cleanly. There's no right
# column, and nothing relies on hiding the score numbers, so 1.20–1.20.2 (red numbers)
# reads the same as 26.3. At most 15 lines.
# Placeholders: TAB's own (%server%, %player%, %online% = network, %serveronline%, %world%,
# %ping%) and, through TAB-Bridge, rapid-core's %rapid_rank_name%, %rapid_bolts%,
# %rapid_tailwind_status%, %rapid_balance_status% (Coins/Crowns), %rapid_world% (the world's
# display name from rapid-core's world-names: "Spawn", not TAB's %world% "rapidskies_spawn"), rapid-hub's
# %rapidhub_status_<group>% ("12 playing" or a red "Offline") and, on Horizons, rapid-claims' %rapidclaims_town% and
# %rapidclaims_here% (whose land you stand on; a dash outside the Heartland).
scoreboard:
  enabled: true
  toggle-command: /sb
  remember-toggle-choice: true
  hidden-by-default: false
  delay-on-join-milliseconds: 0
  scoreboards:
    hub:
      display-condition: "%server%<-hub"
      title: "&#FFD800&lRAPID&f&lSKIES"
      lines:
        - "&8Lobby %server%"
        - ""
        - "&f%player%"
        - "&7Rank: %rapid_rank_name%"
        - "&7Bolts: &#FFAA00%rapid_bolts% ⚡"
        - ""
        - "&#FFD800&lGames"
        - "&7SkyRealms: %rapidhub_status_skyrealms%"
        - "&7Horizons SMP: %rapidhub_status_smp%"
        - ""
        - "&7Network: &f%online% online"
        - ""
        - "&#FFD800rapidskies.us"
    skyrealms:
      display-condition: "%server%<-skyrealms"
      title: "&#FFD800&lRAPID&f&lSKIES"
      lines:
        - "&8SkyRealms %server%"
        - ""
        - "&f%player%"
        - "&7Rank: %rapid_rank_name%"
        - "&7Bolts: &#FFAA00%rapid_bolts% ⚡"
        - "&7Tailwind: &f%rapid_tailwind_status%"
        - ""
        - "&#FFD800&lSkyRealms"
        - "&7Coins: &#FFAA00%rapid_balance_status%"
        # Phase 4b, with SuperiorSkyblock2 on the server (survival plugin set):
        #   - "&7Island level: &f%superior_island_level%"
        #   - "&7Island worth: &f%superior_island_worth%"
        - "&7Players here: &f%serveronline%"
        - ""
        - "&#FFD800rapidskies.us"
    smp:
      display-condition: "%server%<-smp"
      title: "&#FFD800&lRAPID&f&lSKIES"
      lines:
        - "&8Horizons %server%"
        - ""
        - "&f%player%"
        - "&7Rank: %rapid_rank_name%"
        - "&7Bolts: &#FFAA00%rapid_bolts% ⚡"
        - "&7Tailwind: &f%rapid_tailwind_status%"
        - ""
        - "&#FFD800&lHorizons SMP"
        - "&7Crowns: &#FFAA00%rapid_balance_status%"
        - "&7Town: %rapidclaims_town%"
        - "&7Land: %rapidclaims_here%"
        - "&7World: &f%rapid_world%"
        - "&7Players here: &f%serveronline%"
        - ""
        - "&#FFD800rapidskies.us"
    # Build, staging and anything else: who you are and where.
    default:
      title: "&#FFD800&lRAPID&f&lSKIES"
      lines:
        - "&8%server%"
        - ""
        - "&f%player%"
        - "&7Rank: %rapid_rank_name%"
        - "&7Ping: &f%ping%ms"
        - ""
        - "&7Players here: &f%serveronline%"
        - "&7Network: &f%online% online"
        - ""
        - "&#FFD800rapidskies.us"
# How often TAB asks for each placeholder (ms). Values read through TAB-Bridge cost a plugin
# message per player each time, so slow-moving ones are polled less (Bolts are re-read from
# the database once a minute anyway). Replaces TAB's example list.
placeholder-refresh-intervals:
  default-refresh-interval: 500
  "%rapid_rank_name%": 1000
  "%rapid_bolts%": 2000
  "%rapid_tailwind_status%": 5000
  "%rapid_balance_status%": 1000
  "%rapid_world%": 1000
  "%rapidhub_status_skyrealms%": 2000
  "%rapidhub_status_smp%": 2000
  "%rapidclaims_town%": 5000
  "%rapidclaims_here%": 1000
  "%ping%": 2000
layout:
  enabled: false
placeholder-output-replacements: {}
conditions: {}
primary-group-finding-list:
  - owner
  - admin
  - developer
  - srmod
  - moderator
  - helper
  - builder
  - rapidplusplusplus
  - rapidplusplus
  - rapidplus
  - default
