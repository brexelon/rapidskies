# rapid-proxy (Velocity). Same MariaDB schema and Redis as every backend's rapid-core.
database.host: "${DB_HOST}"
database.port: "${DB_PORT}"
database.name: "${RAPID_DB_NAME}"
database.user: "${RAPID_DB_USER}"
database.password: "${RAPID_DB_PASSWORD}"
redis.host: "${REDIS_HOST}"
redis.port: "${REDIS_PORT}"
redis.password: "${REDIS_PASSWORD}"
# Oldest client allowed in: 763 = 1.20 / 1.20.1 (plan §3, version support).
minimum-protocol: 763
# Names players see in /play and queue messages. Set here because the proxy's config.yml
# was written by an older build (which spelled it "Skyrealms").
queue.groups.hub: "Lobby"
queue.groups.skyrealms: "SkyRealms"
queue.groups.smp: "Horizons SMP"
