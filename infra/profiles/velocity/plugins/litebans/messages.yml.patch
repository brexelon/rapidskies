# LiteBans messages in the RapidSkies style (PLAN.md §2). LiteBans doesn't read MiniMessage,
# so these use & codes. Our brand tokens map onto them exactly:
#   primary #FFD800 -> &#FFD800    accent  #FFAA00 -> &6    text    #FFFFFF -> &f
#   muted   #AAAAAA -> &7          dark    #555555 -> &8    success #55FF55 -> &a
#   error   #FF5555 -> &c
# Chat prefix "RAPIDSKIES » " is &#FFD800&lRAPID&f&lSKIES &8» ; staff-only notices use
# "&cStaff &8» " like rapid-proxy's staff chat. Disconnect screens copy rapid-proxy's kick
# screens: the bold wordmark, a blank line, then the message.
#
# Player-facing messages leave out the staff member's name; staff see it in broadcasts,
# /history and /checkban. {hoverText: ...} needs litebans.json.hover_text to show, and
# without it the message just shows without the hover.
#
# Keys are dotted leaf paths on purpose: a mapping value would replace the whole section.
# Untouched: the alts guardrail disclaimer, durations, strings and the time format.

# ---------------------------------------------------------------- defaults
default_ban_reason: "Breaking the network rules"
default_mute_reason: "Breaking the chat rules"

# ---------------------------------------------------------------- disconnect screens
banned_message_base: |-
  &#FFD800&lRAPID&f&lSKIES

  &cYou are banned from the network.

  &7Reason: &f$reason
  &7Ban ID: &6#$id
banned_message: |-
  $base
  &7Expires in: &6$duration

  $appealMessage
banned_message_permanent: |-
  $base
  &7Expires: &cNever

  $appealMessage
banned_message_appeal_message: "&7Appeal at &#FFD800rapidskies.us &7or on our Discord."
banned_message_geoip_blacklist: |-
  &#FFD800&lRAPID&f&lSKIES

  &cConnections from your region aren't allowed.
  &7Region: &f$geoip

command.kick.message: |-
  &#FFD800&lRAPID&f&lSKIES

  &cYou were kicked from the network.

  &7Reason: &f$reason
command.kick.message_no_reason: |-
  &#FFD800&lRAPID&f&lSKIES

  &cYou were kicked from the network.

command.lockdown.kick_message: |-
  &#FFD800&lRAPID&f&lSKIES

  &cThis server is locked down right now.
  &7Reason: &f$reason

  &7Please try again later.
command.lockdown.kick_message_global: |-
  &#FFD800&lRAPID&f&lSKIES

  &cThe network is locked down right now.
  &7Reason: &f$reason

  &7Check &#FFD800rapidskies.us &7or our Discord for updates.

