# Skyrealms: rapid-core serves Coins through Vault (SuperiorSkyblock2) and spends Tailwind here.
server.gamemode: "skyrealms"

# Spawn: centre of the Trading Post's compass rose (the mud pedestal at y 149, as in the
# map's README), facing south-west down the main path to the plaza. When SuperiorSkyblock2
# joins (phase 4b), set its spawn.location to the same point:
#   skyrealms_spawn, 28.5, 150, -30.5, 45, 0
spawn.location: "minecraft:overworld, 28.5, 150, -30.5, 45, 0"
spawn.on-join: "first-join"
spawn.on-death: true
worlds:
  "minecraft:overworld":
    protect: true
    # The island's underside ends at y 124.
    void-y: 100
    time: 6000
    clear-weather: true
    game-rules:
      advance_time: false
      advance_weather: false
      spawn_mobs: false
      spawn_monsters: false
      spawn_phantoms: false
      spawn_patrols: false
      spawn_wandering_traders: false
      pvp: false
      fall_damage: false
      mob_griefing: false
      # Keeps leaves, grass and the build exactly as delivered (the builders shipped it with 0).
      random_tick_speed: 0
      fire_spread_radius_around_player: 0
