# SuperiorSkyblock2 island upgrades on SkyRealms, bought with Coins (rapid-core's Vault
# economy). Generated together with menus/upgrades.yml.patch; keep the two in step.
# The generator-rates upgrade is gone on purpose: Realm Tiers own each island's generator
# (rapid-skyrealms /realm), so buying odds would be overwritten anyway (PLAN.md §5.1).
# Prices are starting points to tune in beta against the Coins supply.
upgrades:
  border-size:
    '1':
      price: 1500.0
      price-type: "Money"
      border-size: 50
      commands:
        - 'island admin setupgrade %player% border-size 2'
        - 'island admin msgall %player% &6&lUpgrades &8» &7Island Size raised: Border: 75x75 blocks!'
    '2':
      price: 6000.0
      price-type: "Money"
      border-size: 75
      commands:
        - 'island admin setupgrade %player% border-size 3'
        - 'island admin msgall %player% &6&lUpgrades &8» &7Island Size raised: Border: 100x100 blocks!'
    '3':
      price: 20000.0
      price-type: "Money"
      border-size: 100
      commands:
        - 'island admin setupgrade %player% border-size 4'
        - 'island admin msgall %player% &6&lUpgrades &8» &7Island Size raised: Border: 150x150 blocks!'
    '4':
      price: 0.0
      price-type: "Money"
      border-size: 150
      commands:
        - 'island admin msg %player% &6&lUpgrades &8» &7Island Size is at its highest level.'
